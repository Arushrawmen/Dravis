# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional API key for OpenAI (sk-...) or OpenRouter (sk-or-v1-...).
OPENAI_API_KEY=

# OPENROUTER_API_KEY: Optional dedicated OpenRouter API key.
OPENROUTER_API_KEY=

# OPENAI_BASE_URL: Optional custom base URL for OpenAI-compatible proxies.
OPENAI_BASE_URL=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cloud SQL PostgreSQL Configuration (Project: gen-lang-client-0889094097)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="dravis_db"
SQL_USER="postgres"
SQL_PASSWORD=""
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
